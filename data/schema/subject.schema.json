{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://it1140.hoangpc.io.vn/data/schema/subject.schema.json",
  "title": "Ngân hàng câu hỏi IT1140",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "code", "title", "language", "sources", "topics", "questions"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "code": { "const": "IT1140" },
    "title": { "const": "Tin học đại cương" },
    "language": { "const": "vi" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "type"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["lecture", "textbook", "exam", "quiz", "reference"] }
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "source", "kind", "difficulty", "prompt", "choices", "answer", "explanation", "tags"],
        "properties": {
          "id": { "type": "string", "pattern": "^it1140-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{3}$" },
          "topic": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "source": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "kind": { "type": "string", "enum": ["theory", "calculation", "code", "application"] },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
          "prompt": { "type": "string", "minLength": 1 },
          "choices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1 }
          },
          "answer": {
            "oneOf": [
              { "type": "integer", "minimum": 0 },
              {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": { "type": "integer", "minimum": 0 }
              }
            ]
          },
          "explanation": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
