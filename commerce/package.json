{
  "name": "it1140-commerce",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node vm/build.mjs",
    "test": "node --test vm/tests/*.test.mjs",
    "start": "node vm/server.mjs",
    "migrate": "node vm/migrate.mjs",
    "preflight": "node vm/ops.mjs preflight",
    "admin": "node vm/ops.mjs",
    "test:prototype": "node build.mjs && node --test tests/*.test.mjs",
    "check:deploy": "npm run build && node --check vm/server.mjs && node --check vm/app.mjs",
    "preview": "node vm/tests/preview.mjs"
  },
  "engines": { "node": ">=24" },
  "dependencies": { "pg": "8.23.1", "nodemailer": "10.1.2" },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "wrangler": "4.151.1"
  }
}
