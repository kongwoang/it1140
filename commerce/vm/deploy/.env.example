# Copy to .env; no passwords in this file. Generate secrets with init-secrets.
DOMAIN=staging.example.com
ACME_EMAIL=owner@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_FROM=IT1140 <login@example.com>
EMAIL_DOMAINS=sis.hust.edu.vn,hust.edu.vn
OTP_MAX_PER_HOUR=1500
# Register a managed Turnstile widget restricted to your exact hostname.
TURNSTILE_SITE_KEY=
SUPPORT_EMAIL=support@example.com
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
PAYMENTS_ENABLED=false
# Only after publishing reviewed seller/terms/privacy/refund information:
SELLER_READY=false
