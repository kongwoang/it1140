# Set using Cloudflare secrets/configuration, NOT in public JS or GitHub.
APP_ORIGIN=https://YOUR-STAGING-DOMAIN
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-ONLY-SERVICE-ROLE-KEY
SEPAY_WEBHOOK_SECRET=YOUR-HMAC-SECRET-AT-LEAST-32-CHARACTERS
BANK_ACCOUNT=YOUR-MB-ACCOUNT-OR-DEDICATED-VA
BANK_ACCOUNT_NAME=YOUR-NAME-AS-SHOWN-BY-THE-BANK
SUPPORT_EMAIL=YOUR-SUPPORT-EMAIL
BANK_CODE=MB
# Only turn on after linking bank, verifying recipients, tests and policies.
PAYMENTS_ENABLED=false
